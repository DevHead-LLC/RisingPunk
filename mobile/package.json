{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "cd android && ./gradlew clean && cd ..",
    "android:clean": "npm run android:clean:platform",
    "android:clean:platform": "node -e \"process.platform==='win32'?process.exit(require('child_process').spawnSync('npm.cmd',['run','android:dev:setup'],{stdio:'inherit'}).status):process.exit(require('child_process').spawnSync('npm',['run','android'],{stdio:'inherit'}).status)\"",
    "android:dev": "node -e \"var env=Object.assign({},process.env);if(!env.ENVFILE)env.ENVFILE='.env.dev';var isWin=process.platform==='win32';var path=require('path');var reactNativeBin=isWin?path.join(process.cwd(),'node_modules','.bin','react-native.cmd'):path.join(process.cwd(),'node_modules','.bin','react-native');var cmd=isWin?['cmd.exe','/c',reactNativeBin,'run-android']:['sh','-c','ENVFILE=.env.dev react-native run-android'];var proc=require('child_process').spawnSync(cmd[0],cmd.slice(1),{stdio:'inherit',env:env,shell:false,cwd:process.cwd()});if(proc.error){console.error('Error:',proc.error.message);process.exit(1);}process.exit(proc.status||proc.signal||0)\"",
    "android:staging": "node -e \"var env=Object.assign({},process.env);if(!env.ENVFILE)env.ENVFILE='.env.staging';var isWin=process.platform==='win32';var path=require('path');var reactNativeBin=isWin?path.join(process.cwd(),'node_modules','.bin','react-native.cmd'):path.join(process.cwd(),'node_modules','.bin','react-native');var cmd=isWin?['cmd.exe','/c',reactNativeBin,'run-android']:['sh','-c','ENVFILE=.env.staging react-native run-android'];var proc=require('child_process').spawnSync(cmd[0],cmd.slice(1),{stdio:'inherit',env:env,shell:false,cwd:process.cwd()});if(proc.error){console.error('Error:',proc.error.message);process.exit(1);}process.exit(proc.status||proc.signal||0)\"",
    "android:prod": "node -e \"var env=Object.assign({},process.env);if(!env.ENVFILE)env.ENVFILE='.env.prod';var isWin=process.platform==='win32';var path=require('path');var reactNativeBin=isWin?path.join(process.cwd(),'node_modules','.bin','react-native.cmd'):path.join(process.cwd(),'node_modules','.bin','react-native');var cmd=isWin?['cmd.exe','/c',reactNativeBin,'run-android']:['sh','-c','ENVFILE=.env.prod react-native run-android'];var proc=require('child_process').spawnSync(cmd[0],cmd.slice(1),{stdio:'inherit',env:env,shell:false,cwd:process.cwd()});if(proc.error){console.error('Error:',proc.error.message);process.exit(1);}process.exit(proc.status||proc.signal||0)\"",
    "android:pixel4a-staging": "cd android && ENVFILE=.env.staging ./gradlew assembleDebug && cd .. && adb -s 0B171JECB16773 install -r android/app/build/outputs/apk/debug/app-debug.apk && adb -s 0B171JECB16773 reverse tcp:8081 tcp:8081 && ENVFILE=.env.staging react-native start",
    "android:dev:setup": "powershell -ExecutionPolicy Bypass -File android-dev.ps1",
    "android:staging:setup": "powershell -ExecutionPolicy Bypass -File android-staging.ps1",
    "android:prod:setup": "powershell -ExecutionPolicy Bypass -File android-prod.ps1",
    "ios": "cd ios && pod install && cd .. && react-native run-ios --simulator='iPhone 17 Pro Max'",
    "ios:clean": "npm run ios:pod && npm run ios:dev",
    "ios:pod": "cd ios && pod install && cd ..",
    "ios:dev": "ENVFILE=.env.dev react-native run-ios --simulator='iPhone 17 Pro Max'",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios",
    "ios:prod": "ENVFILE=.env.prod react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --runInBand; cd ../server && npm test -- --runInBand",
    "android:build:release": "node -e \"process.platform==='win32'?process.exit(require('child_process').spawnSync('npm.cmd',['run','android:build:release:win'],{stdio:'inherit'}).status):process.exit(require('child_process').spawnSync('npm',['run','android:build:release:mac'],{stdio:'inherit'}).status)\"",
    "android:build:release:win": "cd android && gradlew.bat assembleRelease",
    "android:build:release:mac": "cd android && ./gradlew assembleRelease",
    "android:build:bundle": "node -e \"process.platform==='win32'?process.exit(require('child_process').spawnSync('npm.cmd',['run','android:build:bundle:win'],{stdio:'inherit'}).status):process.exit(require('child_process').spawnSync('npm',['run','android:build:bundle:mac'],{stdio:'inherit'}).status)\"",
    "android:build:bundle:win": "cd android && gradlew.bat bundleRelease && cd ../.. && mkdir -p deployments/client/mobile/prod && cp mobile/android/app/build/outputs/bundle/release/app-release.aab deployments/client/mobile/prod/rising-punk-prod.aab && echo \"✅ Production AAB ready: deployments/client/mobile/prod/rising-punk-prod.aab\"",
    "android:build:bundle:mac": "cd android && ./gradlew bundleRelease && cd ../.. && mkdir -p deployments/client/mobile/prod && cp mobile/android/app/build/outputs/bundle/release/app-release.aab deployments/client/mobile/prod/rising-punk-prod.aab && echo \"✅ Production AAB ready: deployments/client/mobile/prod/rising-punk-prod.aab\"",
    "android:build:bundle:staging": "node -e \"process.platform==='win32'?process.exit(require('child_process').spawnSync('npm.cmd',['run','android:build:bundle:staging:win'],{stdio:'inherit'}).status):process.exit(require('child_process').spawnSync('npm',['run','android:build:bundle:staging:mac'],{stdio:'inherit'}).status)\"",
    "android:build:bundle:staging:win": "node -e \"var env=Object.assign({},process.env);env.ENVFILE='.env.staging';var proc=require('child_process').spawnSync(process.platform==='win32'?'npm.cmd':'npm',['run','android:build:bundle:win'],{stdio:'inherit',env:env});process.exit(proc.status||0)\"",
    "android:build:bundle:staging:mac": "cd android && ENVFILE=.env.staging ./gradlew bundleRelease && cd ../.. && mkdir -p deployments/client/mobile/staging && cp mobile/android/app/build/outputs/bundle/release/app-release.aab deployments/client/mobile/staging/rising-punk-staging.aab && echo \"✅ Staging AAB ready: deployments/client/mobile/staging/rising-punk-staging.aab\""
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-google-signin/google-signin": "^15.0.0",
    "@reduxjs/toolkit": "^2.8.2",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-config": "^1.5.9",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^3.17.1",
    "react-native-svg": "^15.11.1",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.6",
    "@react-native/eslint-config": "0.76.6",
    "@react-native/metro-config": "0.76.6",
    "@react-native/typescript-config": "0.76.6",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.6",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-redux": "^7.1.34",
    "eslint": "^8.19.0",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "prettier": "2.8.8",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.4.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
