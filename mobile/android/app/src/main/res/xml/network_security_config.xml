<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- CRITICAL: Allow cleartext traffic to localhost for Metro bundler -->
    <domain-config cleartextTrafficPermitted="true">
        <domain>localhost</domain>
        <domain>127.0.0.1</domain>
        <domain>10.0.2.2</domain>
    </domain-config>
    
    <!-- EXPLICIT: Allow api.risingpunk.com with all certificate sources -->
    <!-- Samsung devices may require explicit domain configuration -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.risingpunk.com</domain>
        <domain includeSubdomains="true">risingpunk.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    
    <!-- BASE: Allow ALL HTTPS with system certificates (most permissive) -->
    <!-- This is the default Android behavior when no network security config exists -->
    <!-- We're explicitly setting it to ensure HTTPS works on all devices -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
